# =====================================================================
# IntelliTraffic — .gitignore
# Keeps secrets, local environments, caches, build output, large
# datasets and verification artifacts out of version control.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & environment configuration
# Never commit credentials, API keys, tokens or deployment secrets.
# .env.example is intentionally tracked as the documented template.
# ---------------------------------------------------------------------
.env
.env.*
*.local
!.env.example

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/

# ---------------------------------------------------------------------
# Node / Frontend (Vite)
# ---------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# Logs & temporary files
# ---------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
*.swp
*~
tempCodeRunnerFile.py

# ---------------------------------------------------------------------
# Large datasets & generated ML artifacts
# Raw downloads and processed/feature Parquet stores are multi-GB and
# are regenerated by scripts/; they must never enter version control.
# ---------------------------------------------------------------------
data/raw/
data/processed/
data/external/
*.parquet
*.csv.gz

# Trained model binaries (regenerated by scripts/); the runtime LightGBM
# V2 model is a plain-text .txt and is intentionally committed.
*.pkl

# ---------------------------------------------------------------------
# Local verification / screenshot artifacts
# ---------------------------------------------------------------------
/*.png
verify_*.png
verification_*.png
final_*.png
regression_check_*.png
governance_section_check.png

# Stitch design export archives (source lives in frontend/stitch_new/)
*.zip

# ---------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Unused Stitch design export
frontend/stitch_new/
